# Fotos dos veículos: só imagens, nunca executar scripts
Options -Indexes
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
